{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Static files never run the Worker; /api/* always does.
    "run_worker_first": ["/api/*"],
    // Next.js static export writes 404.html; serve it for unknown paths.
    "not_found_handling": "404-page"
  },
  // Top level = local dev and tests. Deploys use env.staging / env.production below.
  "d1_databases": [
    { "binding": "DB", "database_name": "real-shop-local", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "real-shop-files-local" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "BETTER_AUTH_URL": "http://localhost:8787", "SITE_URL": "http://localhost:8787" },
  // Secrets (wrangler secret put NAME --env <env>; .dev.vars locally):
  // BETTER_AUTH_SECRET, STRIPE_SECRET_KEY (sk_test_ only), STRIPE_WEBHOOK_SECRET.
  "workers_dev": true,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "d1_databases": [{ "binding": "DB", "database_name": "real-shop-staging", "database_id": "4df85200-e0ed-497d-b2da-ed36b10c703f", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "real-shop-files-staging" }],
      "vars": { "BETTER_AUTH_URL": "https://real-shop-staging.jyi468.workers.dev", "SITE_URL": "https://real-shop-staging.jyi468.workers.dev" },
      "workers_dev": true
    },
    "production": {
      "d1_databases": [{ "binding": "DB", "database_name": "real-shop-production", "database_id": "dba14e3f-59fc-43e8-bd04-1acb74164fe1", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "real-shop-files-production" }],
      "vars": { "BETTER_AUTH_URL": "https://real-shop.jmlr.dev", "SITE_URL": "https://real-shop.jmlr.dev" },
      "routes": [{ "pattern": "real-shop.jmlr.dev", "custom_domain": true }],
      "workers_dev": false
    }
  }
}
